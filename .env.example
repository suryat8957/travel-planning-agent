# ==============================================================================
# ATLAS TRAVEL PLANNING AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your valid API keys:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Required for LLM Agent Reasoning & Planning)
# Get your API key from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Aviationstack API (Required for Real-time Flight Search)
# Get your free API key from: https://aviationstack.com/
# ------------------------------------------------------------------------------
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# ------------------------------------------------------------------------------
# 3. Tavily AI Search API (Required for Hotel & Stay Web Scouting)
# Get your free API key from: https://tavily.com/
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 4. LangSmith Observability & Tracing (Optional, for debugging LangGraph runs)
# Get your API key from: https://smith.langchain.com/
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_smith_api_key_here
LANGCHAIN_PROJECT=travel-planning-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
